#!/bin/sh
# Pre-commit hook: преди всеки комит Claude Code (headless) преглежда
# staged промените и обновява CLAUDE.md, README.md и requirements.txt,
# ако промените са ги направили неточни. Обновените файлове се добавят
# към СЪЩИЯ комит - така в remote винаги отива актуална документация.
#
# Прескачане при нужда:
#   git commit --no-verify              (прескача всички hook-ове)
#   SKIP_DOCS_UPDATE=1 git commit ...   (прескача само този)
#
# Активиране след ново клониране: git config core.hooksPath .githooks

[ -n "$SKIP_DOCS_UPDATE" ] && exit 0

# Ако Claude Code вече изпълнява този hook, не стартираме втори (защита
# от вложено извикване, когато самият Claude прави комита).
[ -n "$CLAUDE_DOCS_HOOK_RUNNING" ] && exit 0
export CLAUDE_DOCS_HOOK_RUNNING=1

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# Ако са променени САМО документационните файлове - няма какво да синхронизираме
code_changes=$(printf '%s\n' "$staged" | grep -vE '^(CLAUDE\.md|README\.md|requirements\.txt)$')
[ -z "$code_changes" ] && exit 0

echo "[pre-commit] Claude синхронизира CLAUDE.md / README.md / requirements.txt..."

claude -p "Прегледай staged промените в това репо (git diff --cached) и провери дали CLAUDE.md, README.md и requirements.txt са все още точни спрямо тях. Обнови САМО това, което промените са направили невярно или непълно: нови/премахнати зависимости -> requirements.txt; нова функционалност, команди, файлове или променена архитектура -> README.md и CLAUDE.md (спазвай стила им - български, обяснителен). Ако нищо не е остаряло - не пипай нищо. НЕ прави git commit и НЕ променяй други файлове." \
  --allowedTools "Read,Glob,Grep,Edit,Write,Bash(git diff:*),Bash(git status:*),Bash(git log:*)" \
  || { echo "[pre-commit] Claude не успя - комитът продължава без обновяване на документацията."; exit 0; }

# Включваме евентуалните обновления в текущия комит
git add CLAUDE.md README.md requirements.txt 2>/dev/null

echo "[pre-commit] Готово."
exit 0
