# Копирай този файл като ".env" и попълни истинския си API ключ.
# НИКОГА не качвай .env файла в git! (виж .gitignore)

# API ключ от https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Кой Claude модел да се използва (по избор, това е стойността по подразбиране)
MODEL_NAME=claude-opus-5

# Език на интерфейса, конзолата и агентите: "bg" (по подразбиране) или "en"
APP_LANG=bg

# LLM доставчик: "anthropic" (облачен, изисква интернет и API ключ)
# или "ollama" (локален модел, работи НАПЪЛНО офлайн)
LLM_PROVIDER=anthropic
# Локален Ollama модел - трябва да поддържа tool calling (qwen3, llama3.1)
OLLAMA_MODEL=qwen3:8b

# --- Модел по РОЛЯ (model routing, по избор) -------------------------
# Всяка роля може да ползва различен модел: супервайзорът взима просто
# triage решение (стига му евтин модел), Developer върши най-тежката
# работа. Без тези редове всички роли ползват общия MODEL_NAME.
# MODEL_SUPERVISOR=claude-haiku-4-5
# MODEL_ANALYST=claude-sonnet-5
# MODEL_DEVELOPER=claude-opus-5
# MODEL_QA=claude-sonnet-5
# (за Ollama: OLLAMA_MODEL_SUPERVISOR и т.н.)

# --- Предпазители и устойчивост (по избор) ----------------------------
# Колко пъти QA може да върне кода на Developer, преди ескалация към човек
# MAX_REWORK=3
# Твърд лимит на цената (USD) за едно изпълнение; 0 или липса = изключен
# MAX_COST_USD_PER_RUN=0.50
# Retry и timeout на LLM извикванията (Anthropic клиента)
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=120
# Резервен модел за критичните решения (triage, QA присъда): при
# неуспех на основния модел решението се опитва повторно с този.
# MODEL_FALLBACK=claude-sonnet-5
# (за Ollama: OLLAMA_MODEL_FALLBACK=llama3.1)

# --- Checkpointing / resume (по избор) --------------------------------
# SQLite файл, в който се записва всяка стъпка на графа: прекъснат run
# със същия thread_id продължава оттам, докъдето е стигнал. Нишката е
# hash на задачата (или изричен THREAD_ID=... за конзолата).
# Дръж файла ИЗВЪН git (виж .gitignore).
# CHECKPOINT_SQLITE_PATH=.checkpoints.sqlite

# Визуализация и дебъг - изцяло локално, без външни услуги:
#   streamlit run app.py       -> уеб UI със стъпките на живо
#   python draw_graph.py       -> Mermaid диаграма на графа (текст)

# --- Режим на работа --------------------------------------------------
# prod (по подразбиране): реална Jira през официалния Atlassian MCP сървър,
#   git репозитории и draft Pull Request (изисква настройките по-долу).
# demo: примерните тикети DEV-101 / DEV-102, кодът остава в отговора, без git.
# UI-ят (streamlit) има дропдаун, който презаписва стойността за сесията.
APP_MODE=prod
# Папка с артефактите на всеки run: runs/<дата_час>_<тикет>/ (планове,
# стъпки, статус, обобщение). Локални клонове на репозиториите (prod).
# RUNS_DIR=runs
# WORKSPACE_DIR=workspace

# --- Human-in-the-Loop (по избор) ---------------------------------------
# Порти, на които графът спира и чака човек: plan (одобрение на плана за
# имплементация), publish (преди commit/push/PR - само prod), escalation
# (при ескалация: повторен опит с указания или край). Липсва = според
# режима (prod: всички; demo: plan,escalation). Празно = без порти.
# HITL_GATES=plan,publish,escalation
# Колко пъти човек може да върне плана за ревизия
# HITL_MAX_REVISIONS=2
# 1 = неинтерактивно одобрение (CI, скриптове) - записва се в журнала
# HITL_AUTO_APPROVE=0

# --- Prod: Jira (Atlassian Remote MCP Server) ------------------------------
JIRA_MCP_AUTH=api_token              # api_token (Basic: email+token) | oauth (mcp-remote, браузър)
JIRA_EMAIL=you@company.com            # за api_token
JIRA_API_TOKEN=...                    # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_CLOUD_ID=myposgroup.atlassian.net  # hostname на сайта (или UUID)
# JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
# JIRA_MCP_COMMAND=npx -y mcp-remote@latest https://mcp.atlassian.com/v1/mcp/authv2   # само за oauth
# JIRA_MCP_TIMEOUT_SECONDS=60
# JIRA_MCP_MAX_RETRIES=2
# JIRA_AC_FIELD=customfield_XXXXX      # custom field с критерии за приемане (по избор)
# JIRA_WRITE_BACK=0                    # 1 = коментар в тикета с PR линковете (от следващата стъпка)
# --- Prod: git репозитории и draft Pull Request ---------------------------
# Репозиториите (със запетаи: owner/name или https://github.com/owner/name),
# в които Developer работи. Клонират се от PROD_BASE_BRANCH в WORKSPACE_DIR;
# всеки run е на нов branch multibot/<тикет>-<run>; след QA APPROVED и човешко
# одобрение (порта publish) - commit, push и `gh pr create --draft`.
# Изисква GitHub CLI: gh auth login (и gh auth setup-git за clone/push по https).
PROD_REPOS=owner/repo1,owner/repo2
# PROD_BASE_BRANCH=main
# PROD_GIT_AUTHOR_NAME=Multi-Bot
# PROD_GIT_AUTHOR_EMAIL=noreply@multibot.local
