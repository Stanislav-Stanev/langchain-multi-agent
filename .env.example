# Копирай този файл като ".env" и попълни истинския си API ключ.
# НИКОГА не качвай .env файла в git! (виж .gitignore)

# API ключ от https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Кой Claude модел да се използва (по избор, това е стойността по подразбиране)
MODEL_NAME=claude-opus-5

# Език на интерфейса, конзолата и агентите: "bg" (по подразбиране) или "en"
APP_LANG=bg

# LLM доставчик: "anthropic" (облачен, изисква интернет и API ключ)
# или "ollama" (локален модел, работи НАПЪЛНО офлайн)
LLM_PROVIDER=anthropic
# Локален Ollama модел - трябва да поддържа tool calling (qwen3, llama3.1)
OLLAMA_MODEL=qwen3:8b

# Визуализация и дебъг - изцяло локално, без външни услуги:
#   streamlit run app.py       -> уеб UI със стъпките на живо
#   python draw_graph.py       -> Mermaid диаграма на графа (текст)
