#!/bin/sh
# Pre-push hook - две отговорности:
#
# 1. ЗАЩИТА НА main: main е продукционен клон - директни push-ове са
#    забранени. Нова функционалност се качва като feature клон и влиза
#    в main през Pull Request.
#
# 2. СИНХРОНИЗАЦИЯ НА ДОКУМЕНТАЦИЯТА: Claude Code (headless) преглежда
#    ВСИЧКИ комити, които предстои да се качат, и ако те са направили
#    CLAUDE.md, README.md, requirements.txt или CHANGELOG.md неточни,
#    ги обновява в ОТДЕЛЕН docs-sync комит. За нова завършена
#    функционалност добавя запис в CHANGELOG.md (release notes) под
#    [Unreleased]. Push-ът тогава се прекъсва с ясно съобщение - пусни
#    `git push` отново и той минава веднага (последният комит вече е
#    docs-sync, повторна проверка няма).
#
# Защо pre-push, а не pre-commit: проверката се случва ВЕДНЪЖ за цялата
# серия комити, а не на всеки комит - по-бързо и по-евтино.
#
# Прескачане при нужда:
#   git push --no-verify               (прескача всички hook-ове)
#   SKIP_DOCS_UPDATE=1 git push ...    (прескача само синхронизацията)
#   SKIP_MAIN_GUARD=1 git push ...     (прескача само защитата на main)
#
# Активиране след ново клониране: git config core.hooksPath .githooks

# Защита от вложено извикване (когато самият Claude изпълнява push)
[ -n "$CLAUDE_DOCS_HOOK_RUNNING" ] && exit 0
export CLAUDE_DOCS_HOOK_RUNNING=1

# Файловете, които hook-ът поддържа актуални
DOC_FILES="CLAUDE.md README.md requirements.txt CHANGELOG.md"
DOC_PATTERN='^(CLAUDE\.md|README\.md|requirements\.txt|CHANGELOG\.md)$'

zero=0000000000000000000000000000000000000000

# git подава по един ред на stdin за всеки ref: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read local_ref local_sha remote_ref remote_sha; do
    # Изтриване на клон - няма какво да проверяваме
    [ "$local_sha" = "$zero" ] && continue

    # --- 1. Защита на main -------------------------------------------------
    if [ "$remote_ref" = "refs/heads/main" ] && [ -z "$SKIP_MAIN_GUARD" ]; then
        echo "[pre-push] ЗАБРАНЕНО: main е продукционен клон - директен push не се допуска."
        echo ""
        echo "  Качи feature клон и направи Pull Request:"
        echo "      git switch -c feature/<име>     (ако още си на main)"
        echo "      git push -u origin feature/<име>"
        echo "      gh pr create --fill"
        echo ""
        echo "  (Извънреден случай: SKIP_MAIN_GUARD=1 git push ... или git push --no-verify)"
        exit 1
    fi

    # --- 2. Синхронизация на документацията и release notes ----------------
    [ -n "$SKIP_DOCS_UPDATE" ] && continue

    # Ако последният комит е docs-sync - това е повторният push след
    # прекъсването; пускаме го без нова проверка.
    git log -1 --pretty=%s "$local_sha" | grep -q '^docs-sync:' && continue

    # Ако документите имат незакомитнати промени, не пипаме нищо -
    # иначе бихме закомитнали чужда недовършена работа.
    if [ -n "$(git status --porcelain -- $DOC_FILES)" ]; then
        echo "[pre-push] Незакомитнати промени по документацията - прескачам синхронизацията."
        continue
    fi

    if [ "$remote_sha" = "$zero" ]; then
        # Нов клон в remote - сравняваме спрямо общия предшественик с main
        base=$(git merge-base origin/main "$local_sha" 2>/dev/null)
        if [ -n "$base" ] && [ "$base" != "$local_sha" ]; then
            diff_spec="$base $local_sha"
            changed=$(git diff --name-only "$base" "$local_sha")
        else
            diff_spec="$local_sha"
            changed=$(git show --pretty=format: --name-only "$local_sha")
        fi
    else
        diff_spec="$remote_sha $local_sha"
        changed=$(git diff --name-only "$remote_sha" "$local_sha")
    fi

    # Ако в качваните комити няма кодови промени (само документация) - пропускаме
    code_changes=$(printf '%s\n' "$changed" | grep -vE "$DOC_PATTERN" | grep -v '^$')
    [ -z "$code_changes" ] && continue

    echo "[pre-push] Claude проверява документацията и release notes спрямо качваните комити..."

    claude -p "Предстои git push на feature клон. Прегледай промените, които ще се качат: git diff $diff_spec (и git log при нужда). Задачи: (1) Провери дали CLAUDE.md, README.md и requirements.txt са все още точни спрямо тези промени и обнови САМО това, което промените са направили невярно или непълно (нови/премахнати зависимости -> requirements.txt; нова функционалност, команди, файлове или променена архитектура -> README.md и CLAUDE.md; спазвай стила им - български, обяснителен). (2) Ако качваните комити добавят или променят ЗАВЪРШЕНА, видима за потребителя функционалност, добави кратък запис за нея в CHANGELOG.md под секцията [Unreleased] в подходящата подсекция (Добавено/Променено/Поправено, формат Keep a Changelog); дребни вътрешни промени НЕ се вписват. Ако вече има точен запис за същата функционалност, не дублирай. Ако нищо не е остаряло и няма нова функционалност - не пипай нищо. НЕ прави git commit и НЕ променяй други файлове." \
      --allowedTools "Read,Glob,Grep,Edit,Write,Bash(git diff:*),Bash(git status:*),Bash(git log:*),Bash(git show:*)" \
      || { echo "[pre-push] Claude не успя - push-ът продължава без обновяване на документацията."; continue; }

    # Ако Claude е променил нещо - отделен docs-sync комит и прекъсваме push-а
    if [ -n "$(git status --porcelain -- $DOC_FILES)" ]; then
        git add $DOC_FILES
        git commit -m "docs-sync: автоматична синхронизация на документация и release notes

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>" --no-verify
        echo ""
        echo "[pre-push] Документацията/release notes бяха обновени в отделен docs-sync комит."
        echo "[pre-push] Пусни 'git push' отново - ще мине веднага, без нова проверка."
        exit 1
    fi

    echo "[pre-push] Документацията и release notes са актуални."
done

exit 0
