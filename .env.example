# Копирай този файл като ".env" и попълни истинския си API ключ.
# НИКОГА не качвай .env файла в git! (виж .gitignore)

# API ключ от https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Кой Claude модел да се използва (по избор, това е стойността по подразбиране)
MODEL_NAME=claude-opus-5

# Език на интерфейса, конзолата и агентите: "bg" (по подразбиране) или "en"
APP_LANG=bg

# LLM доставчик: "anthropic" (облачен, изисква интернет и API ключ)
# или "ollama" (локален модел, работи НАПЪЛНО офлайн)
LLM_PROVIDER=anthropic
# Локален Ollama модел - трябва да поддържа tool calling (qwen3, llama3.1)
OLLAMA_MODEL=qwen3:8b

# --- Модел по РОЛЯ (model routing, по избор) -------------------------
# Всяка роля може да ползва различен модел: супервайзорът взима просто
# triage решение (стига му евтин модел), Developer върши най-тежката
# работа. Без тези редове всички роли ползват общия MODEL_NAME.
# MODEL_SUPERVISOR=claude-haiku-4-5
# MODEL_ANALYST=claude-sonnet-5
# MODEL_DEVELOPER=claude-opus-5
# MODEL_QA=claude-sonnet-5
# (за Ollama: OLLAMA_MODEL_SUPERVISOR и т.н.)

# --- Предпазители и устойчивост (по избор) ----------------------------
# Колко пъти QA може да върне кода на Developer, преди ескалация към човек
# MAX_REWORK=3
# Твърд лимит на цената (USD) за едно изпълнение; 0 или липса = изключен
# MAX_COST_USD_PER_RUN=0.50
# Retry и timeout на LLM извикванията (Anthropic клиента)
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=120
# Резервен модел за критичните решения (triage, QA присъда): при
# неуспех на основния модел решението се опитва повторно с този.
# MODEL_FALLBACK=claude-sonnet-5
# (за Ollama: OLLAMA_MODEL_FALLBACK=llama3.1)

# --- Checkpointing / resume (по избор) --------------------------------
# SQLite файл, в който се записва всяка стъпка на графа: прекъснат run
# със същия thread_id продължава оттам, докъдето е стигнал. Нишката е
# hash на задачата (или изричен THREAD_ID=... за конзолата).
# Дръж файла ИЗВЪН git (виж .gitignore).
# CHECKPOINT_SQLITE_PATH=.checkpoints.sqlite

# Визуализация и дебъг - изцяло локално, без външни услуги:
#   streamlit run app.py       -> уеб UI със стъпките на живо
#   python draw_graph.py       -> Mermaid диаграма на графа (текст)
